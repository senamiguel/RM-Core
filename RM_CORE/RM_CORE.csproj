<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
		<TargetFramework>net9.0-windows10.0.18362.0</TargetFramework>    
		<RootNamespace>RM_Core</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>RM_CORE.ico</ApplicationIcon>
		<AssemblyName>RM_CORE</AssemblyName>
		<Product>RM Core</Product>
		<Title>RM Core</Title>
		<Description>RM Core - Gerenciador de Ambientes e Bases TOTVS RM</Description>
		<Company>Miguel Sena</Company>
		<Copyright>Copyright © 2026 Miguel Sena</Copyright>
    <Version>0.6.10</Version>
    <AssemblyVersion>0.6.10.0</AssemblyVersion>
    <FileVersion>0.6.10.0</FileVersion>
    <InformationalVersion>Alpha-0.6.10</InformationalVersion>
    <PathMap>$(MSBuildProjectDirectory)=/RM_Core</PathMap>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <!-- Prevent WinForms namespace from leaking globally (causes ambiguity with WPF types) -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="RM_CORE.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="iNKORE.UI.WPF" Version="1.2.8" />
    <PackageReference Include="iNKORE.UI.WPF.Modern" Version="0.10.2.1" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="9.0.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="9.0.0" />
    <PackageReference Include="Costura.Fody" Version="5.*">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Fody" Version="6.*">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

</Project>
